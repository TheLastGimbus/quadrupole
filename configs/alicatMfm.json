{
  "name": "",
  "controllers": [
    {
      "type": "UnixTime",
      "params": [
        {
          "type": "time",
          "name": "system time"
        }
      ]
    },
    {
      "type": "alicat_mfm",
      "port": "/dev/ttyUSB0",
      "unit": "A",
      "params": [
        {
          "type": "value",
          "name": "mass flow",
          "unit": "sccm",
          "deviceUnit": "mg/s",
          "gas": "air",
          "movingAverageTime": 1.5,
          "filterType": "median"
        },
        {
          "type": "setpoint",
          "name": "flow setpoint",
          "unit": "sccm",
          "default": 0,
          "min": 0,
          "max": 1000
        },
        {
          "type": "setpoint_readout",
          "name": "setpoint read",
          "unit": "sccm"
        }
      ]
    }
  ]
}
